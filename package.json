{
  "name": "@interior-point/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "simple-git-hooks",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write \"**/*.{ts,mts,mjs,json,md,yml,yaml,vue}\"",
    "format:check": "prettier --check \"**/*.{ts,mts,mjs,json,md,yml,yaml,vue}\"",
    "build:js": "pnpm --filter ./js run build",
    "typecheck:js": "pnpm --filter ./js run typecheck",
    "test:scripts": "node --test \"scripts/test/*.test.mjs\"",
    "test:js": "pnpm --filter ./js run test",
    "test:rs": "cd rs && cargo test --workspace --all-features",
    "test:docs": "node scripts/docs-examples.mjs",
    "test": "pnpm test:scripts && pnpm test:js && pnpm test:rs && pnpm test:docs",
    "bench:js": "pnpm --filter ./js run bench",
    "bench:rs": "cd rs && cargo bench -p interior-point",
    "bench": "pnpm bench:js && pnpm bench:rs",
    "docs:dev": "pnpm --filter ./docs run dev",
    "docs:build": "pnpm --filter ./docs run build",
    "docs:preview": "pnpm --filter ./docs run preview"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.vue": [
      "prettier --write"
    ],
    "*.rs": [
      "rustfmt"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
