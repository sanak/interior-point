{
  "name": "interior-point",
  "version": "0.3.0",
  "description": "Compute an interior point (representative point) of any GeoJSON geometry, ported from JTS",
  "type": "module",
  "license": "MIT",
  "author": "Ko Nagase",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanak/interior-point.git",
    "directory": "js"
  },
  "homepage": "https://sanak.github.io/interior-point/",
  "bugs": "https://github.com/sanak/interior-point/issues",
  "keywords": [
    "geojson",
    "geometry",
    "interior-point",
    "representative-point",
    "polygon",
    "jts",
    "gis"
  ],
  "sideEffects": false,
  "main": "dist/interior-point.cjs",
  "module": "dist/interior-point.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/interior-point.mjs",
      "require": "./dist/interior-point.cjs"
    }
  },
  "bin": {
    "interior-point": "dist/bin/interior-point.js"
  },
  "files": [
    "dist",
    "LICENSE_EDLv1.txt"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && tsc -p tsconfig.cli.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "cp ../LICENSE . && cp ../LICENSE_EDLv1.txt .",
    "test": "node --import tsx --test \"test/**/*Test.ts\"",
    "test:watch": "node --import tsx --test --watch \"test/**/*Test.ts\"",
    "bench": "node --import tsx test/InteriorPointAreaPerfTest.bench.ts"
  },
  "dependencies": {
    "@types/geojson": "^7946.0.16",
    "betterknown": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "fast-xml-parser": "^5.10.1",
    "tinybench": "^6.1.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  }
}
