    "hyparquet-compressors": "^1.1.1",
    "interior-point": "workspace:*",
    "jsts": "^2.12.1",
    "maplibre-gl": "^5.24.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.1",
    "@wcohen/wasmts": "0.1.0-alpha6",
    "happy-dom": "^20.11.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  }
