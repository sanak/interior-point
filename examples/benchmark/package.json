{
  "name": "@interior-point/benchmark",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Browser benchmark comparing interior point implementations",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
